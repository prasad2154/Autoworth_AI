# ============================================================
#  AutoWorth AI — Environment Variables
#  Copy this file to .env and fill in actual values.
#  NEVER commit .env to version control.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql://autoworth_user:autoworth_pass@localhost:5432/autoworth_db
POSTGRES_DB=autoworth_db
POSTGRES_USER=autoworth_user
POSTGRES_PASSWORD=autoworth_pass

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Password Reset ---
RESET_TOKEN_EXPIRE_MINUTES=30

# --- ML ---
MODEL_PATH=models/autoworth_model.pkl
PREPROCESSOR_PATH=models/preprocessor.pkl
METADATA_PATH=models/metadata.json

# --- App ---
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Admin ---
ADMIN_EMAIL=admin@autoworth.ai
ADMIN_PASSWORD=Admin@AutoWorth2024
